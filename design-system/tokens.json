{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens for [CLIENT NAME]. DTCG format. Three tiers: primitive -> semantic -> component. Replace example values. This file is the source of truth for color, spacing, type, radius, and elevation. The AI must pull from here and never invent values. See design-system/README.md for how these map to the Figma variable architecture.",

  "primitive": {
    "color": {
      "$type": "color",
      "brand": {
        "500": { "$value": "#2563EB", "$description": "EXAMPLE primary hue. Replace." },
        "600": { "$value": "#1D4ED8", "$description": "EXAMPLE darker step." }
      },
      "neutral": {
        "0":   { "$value": "#FFFFFF" },
        "900": { "$value": "#111827", "$description": "EXAMPLE near-black text." }
      },
      "feedback": {
        "success": { "$value": "#15803D" },
        "danger":  { "$value": "#B91C1C" }
      }
    },
    "space": {
      "$type": "dimension",
      "$description": "Unitless-style 8pt scale. Values in px. Vary usage for hierarchy.",
      "1": { "$value": "4" },
      "2": { "$value": "8" },
      "3": { "$value": "16" },
      "4": { "$value": "24" },
      "5": { "$value": "32" },
      "6": { "$value": "48" },
      "7": { "$value": "64" }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": "4" },
      "md": { "$value": "8" },
      "pill": { "$value": "999" }
    },
    "shadow": {
      "$type": "shadow",
      "$description": "Elevation. EXAMPLE values; keep light for editorial brands.",
      "sm": { "$value": { "color": "#0000000d", "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0" } },
      "md": { "$value": { "color": "#00000014", "offsetX": "0", "offsetY": "4px", "blur": "6px", "spread": "-1px" } },
      "lg": { "$value": { "color": "#0000001a", "offsetX": "0", "offsetY": "10px", "blur": "15px", "spread": "-3px" } }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": { "$value": "[Display face]", "$description": "Replace. Distinctive heading face." },
        "body":    { "$value": "[Body face]", "$description": "Replace. Clean readable body face." }
      },
      "size": {
        "$type": "dimension",
        "$description": "16px base, 1.25 scale example. Adjust ratio in typography.md.",
        "base": { "$value": "16" },
        "lg":   { "$value": "20" },
        "xl":   { "$value": "25" },
        "2xl":  { "$value": "31" },
        "3xl":  { "$value": "39" }
      }
    }
  },

  "semantic": {
    "$description": "Purpose-tied aliases. This is what components and the AI reference by name.",
    "color": {
      "$type": "color",
      "action-primary":   { "$value": "{primitive.color.brand.500}", "$extensions": { "wcag": "MEASURE ratio on bg-default and record here" } },
      "action-primary-hover": { "$value": "{primitive.color.brand.600}" },
      "text-default":     { "$value": "{primitive.color.neutral.900}", "$extensions": { "wcag": "MEASURE on bg-default (target 4.5:1)" } },
      "bg-default":       { "$value": "{primitive.color.neutral.0}" },
      "feedback-success": { "$value": "{primitive.color.feedback.success}" },
      "feedback-danger":  { "$value": "{primitive.color.feedback.danger}" }
    },
    "space": {
      "$type": "dimension",
      "stack-sm": { "$value": "{primitive.space.2}" },
      "stack-md": { "$value": "{primitive.space.4}" },
      "stack-lg": { "$value": "{primitive.space.6}" }
    }
  },

  "component": {
    "$description": "Component-level tokens, aliasing semantic tokens.",
    "button": {
      "padding-x": { "$type": "dimension", "$value": "{primitive.space.4}" },
      "padding-y": { "$type": "dimension", "$value": "{primitive.space.2}" },
      "radius":    { "$type": "dimension", "$value": "{primitive.radius.pill}" }
    },
    "card": {
      "padding":  { "$type": "dimension", "$value": "{primitive.space.5}" },
      "radius":   { "$type": "dimension", "$value": "{primitive.radius.md}" }
    }
  }
}
